# Required. Use a dedicated PostgreSQL database and credentials.
INFRADESK_DB_URL=jdbc:postgresql://localhost:5432/infradesk
INFRADESK_DB_USER=infradesk
INFRADESK_DB_PASSWORD=change-me
INFRADESK_SECRET_MASTER_KEY_BASE64=<base64-encoded-32-byte-key>

# Optional defaults.
INFRADESK_HTTP_HOST=0.0.0.0
INFRADESK_HTTP_PORT=8080
INFRADESK_AUTH_SESSION_TTL_SECONDS=604800
INFRADESK_AUTH_COOKIE_SECURE=false
INFRADESK_SCHEDULER_POLL_INTERVAL_SECONDS=1
INFRADESK_SCHEDULER_BATCH_SIZE=100
INFRADESK_SCHEDULER_MAX_CONCURRENCY=5
INFRADESK_SCHEDULER_CLAIM_LEASE_SECONDS=900
INFRADESK_TERMINAL_INITIAL_COLUMNS=80
INFRADESK_TERMINAL_INITIAL_ROWS=24
INFRADESK_TERMINAL_MAX_COLUMNS=500
INFRADESK_TERMINAL_MAX_ROWS=200
INFRADESK_TERMINAL_MAX_FRAME_BYTES=65536
INFRADESK_TERMINAL_MAX_CONTROL_BYTES=8192
INFRADESK_TERMINAL_IDLE_TIMEOUT_SECONDS=1800
INFRADESK_TERMINAL_MAX_LIFETIME_SECONDS=7200
INFRADESK_TERMINAL_MAX_CONCURRENT_SESSIONS=16
INFRADESK_TERMINAL_MAX_USER_SESSIONS=4
INFRADESK_TERMINAL_MAX_ORGANIZATION_SESSIONS=32
INFRADESK_TERMINAL_HEARTBEAT_SECONDS=15
INFRADESK_TERMINAL_LEASE_SECONDS=45

# Optional notifications. Without a webhook URL the subsystem is disabled.
# INFRADESK_NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/infradesk
INFRADESK_NOTIFICATION_POLL_INTERVAL_SECONDS=5
INFRADESK_NOTIFICATION_BATCH_SIZE=50
INFRADESK_NOTIFICATION_MAX_CONCURRENCY=5
INFRADESK_NOTIFICATION_CLAIM_LEASE_SECONDS=60
INFRADESK_NOTIFICATION_REQUEST_TIMEOUT_SECONDS=10
INFRADESK_NOTIFICATION_MAX_ATTEMPTS=10

# External product API integrations. Only the deployment can allow private destinations.
INFRADESK_INTEGRATIONS_REQUEST_TIMEOUT_SECONDS=10
INFRADESK_INTEGRATIONS_ALLOW_PRIVATE_DESTINATIONS=false
# Read-only Remnawave observation of enabled integrations (manual Sync now works regardless).
INFRADESK_INTEGRATIONS_SYNC_ENABLED=true
INFRADESK_INTEGRATIONS_SYNC_POLL_INTERVAL_SECONDS=5
INFRADESK_INTEGRATIONS_SYNC_INTERVAL_SECONDS=60
INFRADESK_INTEGRATIONS_SYNC_BATCH_SIZE=20
INFRADESK_INTEGRATIONS_SYNC_MAX_CONCURRENCY=3
INFRADESK_INTEGRATIONS_SYNC_CLAIM_LEASE_SECONDS=90
INFRADESK_INTEGRATIONS_SYNC_ATTEMPT_TIMEOUT_SECONDS=30
INFRADESK_INTEGRATIONS_INVENTORY_MAX_RESPONSE_BYTES=8388608
INFRADESK_INTEGRATIONS_INVENTORY_MAX_OBJECTS=10000
# Durable integration actions. Desired-state reconciliation requires this worker and synchronization.
INFRADESK_INTEGRATIONS_ACTIONS_ENABLED=true
# Desired state of explicitly managed Remnawave nodes requires synchronization and actions.
INFRADESK_INTEGRATIONS_DESIRED_STATE_ENABLED=true
INFRADESK_INTEGRATIONS_DESIRED_STATE_POLL_INTERVAL_SECONDS=5
INFRADESK_INTEGRATIONS_DESIRED_STATE_BATCH_SIZE=50
INFRADESK_INTEGRATIONS_DESIRED_STATE_MAX_CONCURRENCY=4
INFRADESK_INTEGRATIONS_DESIRED_STATE_CLAIM_LEASE_SECONDS=30
INFRADESK_INTEGRATIONS_CONFIG_ROLLOUTS_ENABLED=true
INFRADESK_INTEGRATIONS_CONFIG_ROLLOUTS_POLL_INTERVAL_SECONDS=2
INFRADESK_INTEGRATIONS_CONFIG_ROLLOUTS_BATCH_SIZE=20
INFRADESK_INTEGRATIONS_CONFIG_ROLLOUTS_MAX_CONCURRENCY=2
INFRADESK_INTEGRATIONS_CONFIG_ROLLOUTS_CLAIM_LEASE_SECONDS=30
INFRADESK_INTEGRATIONS_CONFIG_ROLLOUTS_VERIFY_TIMEOUT_SECONDS=180

# Optional bootstrap: set all four or none. Organization must already exist.
# INFRADESK_BOOTSTRAP_EMAIL=admin@example.com
# INFRADESK_BOOTSTRAP_PASSWORD=<choose-a-password>
# INFRADESK_BOOTSTRAP_ORGANIZATION_ID=<existing-organization-uuid>
# INFRADESK_BOOTSTRAP_DISPLAY_NAME=Administrator

# Legacy SSH env: secret references may point to named environment variables.
# SSH_PASSWORD_FOR_VPS=<ssh-password>
