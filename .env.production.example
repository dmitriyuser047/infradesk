# Template for the production environment file. Copy it to a host path outside this repository,
# for example /etc/infradesk/infradesk.env with mode 600, and replace every CHANGE_ME.
# Never commit a filled-in copy.

# --- database -----------------------------------------------------------------------------
INFRADESK_DB_NAME=infradesk
INFRADESK_DB_USER=infradesk
INFRADESK_DB_PASSWORD=CHANGE_ME
INFRADESK_DB_MAX_POOL_SIZE=10
INFRADESK_DB_CONNECTION_TIMEOUT_SECONDS=10

# --- secrets ------------------------------------------------------------------------------
# Created once with `openssl rand -base64 32` and kept forever: it decrypts the connection
# secrets already stored. Regenerating it makes them unreadable. Back it up separately from the
# database dump.
INFRADESK_SECRET_MASTER_KEY_BASE64=CHANGE_ME

# --- authentication -----------------------------------------------------------------------
# The cookie is only sent over HTTPS in production.
INFRADESK_AUTH_COOKIE_SECURE=true
INFRADESK_AUTH_SESSION_TTL_SECONDS=604800

# --- first boot ---------------------------------------------------------------------------
# Optional and only needed until the first administrator exists. All four values must be set
# together. The organization UUID must already exist; see the first-deployment runbook.
INFRADESK_BOOTSTRAP_EMAIL=
INFRADESK_BOOTSTRAP_PASSWORD=
INFRADESK_BOOTSTRAP_ORGANIZATION_ID=
INFRADESK_BOOTSTRAP_DISPLAY_NAME=

# --- notifications ------------------------------------------------------------------------
# Deployment-level webhook; empty disables notifications entirely.
INFRADESK_NOTIFICATION_WEBHOOK_URL=
INFRADESK_NOTIFICATION_POLL_INTERVAL_SECONDS=5
INFRADESK_NOTIFICATION_BATCH_SIZE=50
INFRADESK_NOTIFICATION_MAX_CONCURRENCY=5
INFRADESK_NOTIFICATION_CLAIM_LEASE_SECONDS=60
INFRADESK_NOTIFICATION_REQUEST_TIMEOUT_SECONDS=10
INFRADESK_NOTIFICATION_MAX_ATTEMPTS=10

# --- scheduler ----------------------------------------------------------------------------
INFRADESK_SCHEDULER_ENABLED=true
INFRADESK_SCHEDULER_POLL_INTERVAL_SECONDS=1
INFRADESK_SCHEDULER_BATCH_SIZE=100
INFRADESK_SCHEDULER_MAX_CONCURRENCY=5
INFRADESK_SCHEDULER_CLAIM_LEASE_SECONDS=900

# --- images and exposure ------------------------------------------------------------------
# Deploy by immutable tag, never by `latest`.
INFRADESK_BACKEND_IMAGE=infradesk-backend:CHANGE_ME
INFRADESK_FRONTEND_IMAGE=infradesk-frontend:CHANGE_ME
INFRADESK_GIT_SHA=CHANGE_ME
INFRADESK_BUILD_VERSION=CHANGE_ME
# The TLS terminator in front of this host is what listens publicly.
INFRADESK_HTTP_PUBLISH=127.0.0.1:8081

# --- limits ---------------------------------------------------------------------------------
INFRADESK_BACKEND_MEMORY_LIMIT=1g
INFRADESK_POSTGRES_MEMORY_LIMIT=1g
