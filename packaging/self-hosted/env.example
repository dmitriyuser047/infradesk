# InfraDesk self-hosted configuration: /etc/infradesk/infradesk.env
#
# The installer writes this file (owner root, mode 600) and keeps it across updates. You do not
# need to create it by hand. This example contains no secrets; every value marked "secret" is
# generated by the installer with a cryptographically secure random generator.
#
# Back the real file up separately and securely: it holds the key that decrypts the SSH
# credentials stored in the database. A database backup without it cannot restore connections.

# Installer bookkeeping. Non-secret. Do not change.
INFRADESK_INSTALLER_SCHEMA_VERSION=1

# Required, secret. PostgreSQL password (64 hex characters). Set once; not rotated by InfraDesk.
INFRADESK_DB_PASSWORD=

# Required, secret. 32 random bytes, Base64. Set once and never change it: it decrypts the stored
# SSH credentials. Losing or replacing it makes every stored credential unusable.
INFRADESK_SECRET_MASTER_KEY_BASE64=

# Required. Where InfraDesk listens on this host, ADDRESS:PORT. Default 127.0.0.1:8080, so an
# existing reverse proxy (nginx, Caddy, Traefik) terminates HTTPS in front of it. 0.0.0.0:PORT
# exposes it on every interface: only for a trusted LAN or a test machine.
INFRADESK_HTTP_PUBLISH=127.0.0.1:8080

# true (default) when users reach InfraDesk over HTTPS; the sign-in cookie is then HTTPS-only.
# false only for plain-HTTP testing, where a browser would otherwise refuse the cookie.
INFRADESK_AUTH_COOKIE_SECURE=true

# Required. The private Docker network of InfraDesk, a /24 that no other network on this host
# uses; the installer picks a free one. TRUSTED_PROXY_CIDR is its .1 gateway as /32 — change
# both together, never to 0.0.0.0/0.
INFRADESK_INTERNAL_SUBNET=172.28.0.0/24
INFRADESK_TRUSTED_PROXY_CIDR=172.28.0.1/32

# Optional. Deployment-level notification webhook (absolute http/https URL); empty disables it.
INFRADESK_NOTIFICATION_WEBHOOK_URL=

# Optional external product API policy. Private destinations require an operator decision.
INFRADESK_INTEGRATIONS_REQUEST_TIMEOUT_SECONDS=10
INFRADESK_INTEGRATIONS_ALLOW_PRIVATE_DESTINATIONS=false

# Optional. Memory limits per container (Docker notation). Defaults suit a 4 GiB host.
# INFRADESK_BACKEND_MEMORY_LIMIT=1g
# INFRADESK_POSTGRES_MEMORY_LIMIT=1g
